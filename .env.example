# Copia estos valores en Vercel > tu proyecto > Settings > Environment Variables
# Los encuentras en Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anon_publica
# Una frase secreta cualquiera, larga (sirve para contar visitantes sin guardar su IP)
VISITAS_SAL=escribe-aqui-una-frase-larga-y-secreta
